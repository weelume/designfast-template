{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "PORT": {
      "type": "string",
      "default": "43632",
      "pattern": "^[0-9]+$",
      "x-secret": false,
      "x-exposure": "server"
    },
    "TEMPLATE_HOST": {
      "type": "string",
      "default": "127.0.0.1",
      "x-secret": false,
      "x-exposure": "server"
    }
  },
  "required": []
}
